  "version": "0.2.0",
  "configurations": [
    {
      "name": "coding_helper_cross_platform",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define",
        "CODING_HELPER_API_URL=http://localhost:3000",
      ]
    },
    {
      "name": "coding_helper_cross_platform (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart"
    },
    {
      "name": "coding_helper_cross_platform (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart"
    }
  ]
}
