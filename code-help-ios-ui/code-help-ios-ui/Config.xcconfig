CLIENT_ID = code-help-ios

AUTHORIZATION_ENDPOINT = $(ORIGIN)/iam/realms/code-help/protocol/openid-connect/auth
TOKEN_ENDPOINT = $(ORIGIN)/iam/realms/code-help/protocol/openid-connect/token
