{
  "name": "coding-helper-ui-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types:core-api": "openapi-generator-cli generate -i src/docs/code-help-core-api.yaml -g typescript-fetch -o src/generated/core-api --additional-properties=withInterfaces=true",
    "generate-types:forum-api": "openapi-generator-cli generate -i src/docs/forum-api.yaml -g typescript-fetch -o src/generated/forum-api --additional-properties=withInterfaces=true",
    "generate-types": "rimraf -rf /src/generated && run-p generate-types:*"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/react": "^4.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "astro": "^5.5.5",
    "astro-icon": "^1.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@openapitools/openapi-generator-cli": "^2.18.4",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5"
  }
}
