---
interface Props {
  id: number;
  title: string;
  content: string;
  username: string;
}

const props = Astro.props;
---

<style>
  .container {
    border: 1px solid #c2c2c2;
    box-shadow: #c2c2c2 0 0 0.7px 0.2px;
    border-radius: 10px;
    padding: 20px;

    display: grid;
    gap: 10px;
  }

  .title {
    font-size: 1.1rem;
    font-weight: bold;
  }

  .description {
    color: #c2c2c2;
  }

  .footer {
    color: #c2c2c2;
    font-size: 0.8rem;
  }
</style>

<div class="container">
  <div>
    <div class="title">{props.title}</div>
    <div class="description">{props.content}</div>
    <div class="footer">
      <div class="user">By {props.username}</div>
    </div>
  </div>
</div>
