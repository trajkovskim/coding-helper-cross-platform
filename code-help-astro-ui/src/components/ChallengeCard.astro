---
interface Props {
  id: number;
  title: string;
  description: string;
  category: string;
  difficulty: string;
  likes: number;
}

const props = Astro.props;
---

<style>
  .container {
    border: 1px solid #c2c2c2;
    box-shadow: #c2c2c2 0 0 0.7px 0.2px;
    border-radius: 10px;
    padding: 20px;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .difficulty {
    background-color: green;
    border-radius: 13px;
    padding: 4px 15px;
    font-size: 12px;
    color: white;
    font-weight: bold;
  }

  .category {
    font-size: 1rem;
    color: #c2c2c2;
  }

  .title {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: bold;
    color: #0c0c0c;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .card-body {
    color: #0c0c0c;
    text-align: justify;
    font-size: 1rem;
  }

  .card-footer {
    font-size: 0.8rem;
    color: #c2c2c2;
  }
</style>

<div class="container">
  <div class="card-header">
    <div>
      <span class="title">{props.title}</span>
      <div class="category">{props.category}</div>
    </div>
    <span class="difficulty">{props.difficulty}</span>
  </div>
  <div class="card-body">{props.description}</div>
  <div class="card-footer">
    Liked by {props.likes} users
  </div>
</div>
