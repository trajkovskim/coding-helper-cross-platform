---
import Layout from '../layouts/Layout.astro';
import Categories from '../react/components/Categories';
import Challenges from '../react/components/Challenges';
import UpcomingContests from '../react/components/UpcomingContests';
import Communities from '../react/components/Communities';
import ChallengeOfTheDay from '../react/components/ChallengeOfTheDay';
import Posts from '../react/components/Posts';
---

<style>
  .title {
    background-image: linear-gradient(to right, #1cb5e0, #000046);
    background-clip: text;
    color: transparent;
  }

  .top {
    overflow: hidden;

    padding-top: 50px;
    padding-bottom: 50px;
    background: #000046; /* fallback for old browsers */
    background: -webkit-linear-gradient(to right, #1cb5e0, #000046); /* Chrome 10-25, Safari 5.1-6 */
    background: linear-gradient(
      to right,
      #1cb5e0,
      #000046
    ); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
    color: white;
    position: relative;
  }

  .box {
    display: flex;
    gap: 50px;
    align-items: center;
  }

  .grow {
    backdrop-filter: blur(50px);
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    border-radius: 7px;
    flex-grow: 1;
    padding: 40px;
    position: relative;
  }

  .grow::before {
    content: '';
    position: absolute;
    width: 110%;
    height: 130%;
    /* background-color: black; */
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    rotate: -7deg;
    border-radius: 7px;
    top: -70px;
    left: -40px;
    filter: brightness(110%);
  }

  .challenges-by-difficulty-section {
    display: grid;
    grid-template: 1fr / repeat(3, 1fr);
    gap: 20px;
  }

  .popular-challenges {
    display: grid;
    grid-template: 1fr / repeat(4, 1fr);
    gap: 20px;
  }

  .communities,
  .posts {
    border: 1px var(--secondary-color) solid;
    padding: min(20px, 8%);
    border-radius: 10px;
  }

  .communities-list,
  .posts-list {
    display: grid;
    gap: 20px;
  }
</style>

<Layout title="Coding helper">
  <main>
    <div class="top">
      <div class="page-padding page-size centered box">
        <div style="max-width: 600px;">
          <h1 class="pb-xl">Prove your coding skills with our challenges</h1>
          <p class="text-lg">
            Master algorithms, ace technical interviews, and connect with a global community of developers.
          </p>
        </div>
        <div class="grow">
          <ChallengeOfTheDay client:only="react" />
          <!--<ProblemOfTheDay-->
          <!--  id={problemsResponse[0].id}-->
          <!--  title={problemsResponse[0].name}-->
          <!--  likes={problemsResponse[0].likes}-->
          <!--  difficulty={problemsResponse[0].difficulty}-->
          <!--  description={problemsResponse[0].description}-->
          <!--  testCase={problemsResponse[0].testCases[0]}-->
          <!--/>-->
        </div>
      </div>
    </div>
    <div class="page-size page-padding centered page-section-gap">
      <h3>Challenges</h3>
      <p class="pb-xl">Practice problems organized by topic to build your skills systematically</p>
      <div class="grid-by-4">
        <Categories client:only="react"/>
      </div>
    </div>
    <!-- <div class="page-size page-padding centered page-section-gap">
      <h2 class="pb-xl">Explore challenges</h2>
      <div class="challenges-by-difficulty-section">
        <ChallengesByDifficulty difficulty="easy" />
        <ChallengesByDifficulty difficulty="medium" />
        <ChallengesByDifficulty difficulty="hard" />
      </div>
    </div> -->
    <div class="page-size page-padding centered page-section-gap">
      <h3>Popular challenges</h3>
      <p class="pb-xl">Tackle the most solved and discussed problems on our platform</p>
      <div class="grid-by-4">
        <Challenges client:only="react"/>
      </div>
    </div>
    <div class="page-size page-padding centered page-section-gap">
      <h3>Upcomming contests</h3>
      <p class="pb-xl">Participate in coding competitions to test your skills and win prizes</p>
      <div class="grid-by-2">
        <UpcomingContests client:only="react"/>
      </div>
    </div>
    <div class="page-size page-padding centered page-section-gap">
      <h3>Join a community</h3>
      <p class="pb-xl">Connect with fellow developers, share solutions, and learn together</p>
      <div class="grid-by-2">
        <div class="communities">
          <h4>Communities</h4>
          <div class="communities-list">
            <Communities client:only="react"/>
          </div>
        </div>
        <div class="posts">
          <h4>Recent posts</h4>
          <div class="posts-list">
              <Posts client:only="react"/>
          </div>
        </div>
      </div>
    </div>

    <div class="page-size page-padding centered page-section-gap">
      <h3>Ready to Improve Your Coding Skills?</h3>
      <p class="text-lg">
        Join thousands of developers who are mastering algorithms and acing technical interviews with CodingHelper.
      </p>
    </div>
  </main>
</Layout>
