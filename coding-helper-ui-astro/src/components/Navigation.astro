---
import { Icon } from 'astro-icon/components'

const navigationOptions = [
  {
    label: "Problems",
    href: "/problems",
  },
  {
    label: "Contests",
    href: "/contests",
  },
  {
    label: "Forum",
    href: "/forum",
  },
];
---
<style>
    a {
        display: inline-block;
        padding: 20px 15px;
        text-decoration: none;
        color: inherit;
    }
    
    nav {
        box-shadow: 0 2px 2px -2px rgba(0,0,0,.2);
        display: flex;
        align-items: center;
    }
</style>

<nav>
    <a href="/"></a>
  {navigationOptions.map((option) => <a href={option.href}>{option.label}</a>)}
</nav>
