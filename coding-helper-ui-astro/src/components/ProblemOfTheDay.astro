---
interface Props {
  id: number;
  title: string;
  description: string;
  difficulty: string;
  input: string;
  likes: number;
}

const props = Astro.props;
---

<style>
  .box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
  }

  .difficulty {
    background-color: green;
    border-radius: 13px;
    padding: 4px 15px;
    font-size: 12px;
  }

  .likedby {
    font-size: 12px;
  }

  .input code {
    backdrop-filter: blur(4px);
    background-color: rgba(220, 220, 220, 0.4);
    padding: 20px;
    display: block;
    border-radius: 7px;
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .title {
    font-size: 26px;
  }

  .btn {
    max-width: 200px;
    padding: 10px 20px;
    border: 0;
    background-color: rgba(220, 220, 220, 0.4);
    border-radius: 7px;
    color: white;
    align-self: end;
    font-size: large;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .dots {
    height: 1px;
    width: 1px;
    box-shadow: 0 0 0 7px red, 25px 0 0 7px orange, 50px 0 0 7px green;
    position: relative;
    left: 7px;
    border-radius: 50%;
  }
</style>

<div class="container">
  <div class="head">
    <div class="dots"></div>
    <div class="title">{props.title}</div>
    <div class="box">
      <span class="difficulty">{props.difficulty}</span>
      <span class="likedby">Liked by {props.likes} users</span>
    </div>
    <div>{props.description}</div>
  </div>
  <div class="input">
    <code>
      <div>
        Input: nums = {props.input}, target = 9
      </div>
      <div>
        Output: {props.input}
      </div>
    </code>
  </div>
  <button class="btn">Check it out</button>
</div>
