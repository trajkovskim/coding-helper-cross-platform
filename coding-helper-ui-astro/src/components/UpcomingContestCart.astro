---
interface Props {
  id: number;
  title: string;
  description: string;
  startDate: Date;
  duration: string;
}

const props = Astro.props;
---

<style>
  .container {
    display: flex;
    gap: 30px;
    padding: 10px;
    align-items: center;
  }

  .title {
    font-size: 1.1rem;
    font-weight: bold;
    color: #0c0c0c;
  }

  .body {
    color: #c2c2c2;
  }

  .duration {
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
</style>

<div class="container">
  <div>
    <div>{props.startDate.toLocaleDateString()}</div>
    <div>{props.startDate.toLocaleTimeString()}</div>
  </div>
  <div class="card-content">
    <div class="header">
      <div class="title">{props.title}</div>
      <div class="duration">{props.duration}</div>
    </div>
    <div class="body">{props.description}</div>
  </div>
</div>
